# Required for cloud stages
KIMI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Frame backend — local (Ollama archetypes), gemini, three (3D films), or cinematic (image-led portrait films)
FRAME_BACKEND=local

# Image-led cinematic 3D Shorts — required only for the Cinematic 3D format.
# Keep the actual value only in worker/.env, never in this tracked example file.
OPENAI_API_KEY=
CINEMATIC_IMAGE_PROVIDER=openai
CINEMATIC_IMAGE_MODEL=gpt-image-2
CINEMATIC_IMAGE_SIZE=1024x1536
CINEMATIC_IMAGE_QUALITY=high

# Optional local ComfyUI provider for 3D Shorts. Start ComfyUI's local server,
# then select "ComfyUI Local" in /films. The built-in test workflow is tuned
# for the RTX 3070's 8 GB VRAM and needs the exact checkpoint filename shown
# by ComfyUI (for example an SDXL checkpoint). It renders 768x1152 then the
# existing 1080x1920 HyperFrames composition handles the final crop/motion.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT_NAME=
COMFYUI_IMAGE_WIDTH=768
COMFYUI_IMAGE_HEIGHT=1152
COMFYUI_STEPS=20
COMFYUI_CFG=6.0
COMFYUI_TIMEOUT_SECONDS=300
# Optional advanced route: export a ComfyUI graph with "Save (API Format)".
# The graph can use {{PROMPT}}, {{NEGATIVE_PROMPT}}, {{SEED}}, {{WIDTH}},
# {{HEIGHT}}, and {{CHECKPOINT}} placeholders.
COMFYUI_WORKFLOW_PATH=

# 3D scene model — provider + model
# Provider: "kimi", "gemini", or "deepseek"
SCENE_MODEL_PROVIDER=kimi
# Model name: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k, gemini-2.0-flash, deepseek-chat, etc.
SCENE_MODEL=moonshot-v1-8k
# Required when SCENE_MODEL_PROVIDER=kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
# Required when SCENE_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# X/Twitter API v2 (text posts)
# OAuth 1.0a user context — these tokens do not expire. Get them from
# developer.x.com → Keys & Tokens → OAuth 1.0a after setting permissions to
# "Read and write".
FCE_X_API_KEY=
FCE_X_API_SECRET=
FCE_X_ACCESS_TOKEN=
FCE_X_ACCESS_TOKEN_SECRET=

# 3D verification gate — absolute thresholds (not ratios)
# A shot darker than this is unlit, or the camera is inside geometry.
MIN_MEAN_LUMA=0.02
# A frame flatter than this is a single fill: void, fog, or an inside-out mesh.
MIN_VARIANCE=0.0008
# Perceptual-hash distance at or below this counts as "the same picture."
MAX_HAMMING_FOR_IDENTICAL=4

# Per-shot retries before reporting failure (3 attempts total)
SHOT_RETRIES=2
# Absolute floor: a film with fewer verified frames than this is aborted
MIN_VERIFIED_FRAMES=3

# Worker
WORKER_HOST=127.0.0.1
WORKER_PORT=8000

# Postgres — connection strings are in the real .env (gitignored)
